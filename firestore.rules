rules_version = '2';

// Bakery system security rules.
//
// Two invariants that must never be weakened:
//   1. Nothing is ever deleted, by anyone.
//   2. Sales are append-only except for two whitelisted, stamped mutations:
//      the void flag and the cash<->card payment fix.
//
// Role and branch come from the caller's own /users doc, so the owner manages
// permissions in-app with no custom-claims machinery.

service cloud.firestore {
  match /databases/{database}/documents {

    // Role and outlet come from the signed-in token, not from a document.
    //
    // These used to read /users/{uid}. That works for fetching one document but
    // quietly breaks queries: the read is repeated for every candidate row and
    // soon trips Firestore's per-request document-access limit, so a query that
    // is fine on a quiet day fails once the day gets busy. Reading the token
    // costs nothing and behaves the same whether one row or a thousand come
    // back. `functions/index.js` mirrors the /users doc onto the token, so the
    // owner still manages people in the app and that record stays the truth.
    function signedIn() {
      return request.auth != null;
    }
    function active() {
      return signedIn() && request.auth.token.active == true;
    }
    function role() {
      return request.auth.token.role;
    }
    function myBranch() {
      return request.auth.token.branchId;
    }
    function isOwner() {
      return active() && role() == 'owner';
    }
    function staff() {
      return active() && role() in ['owner', 'cashier', 'specialist'];
    }
    // The owner may act on any branch; everyone else only on their own.
    function canWriteBranch(b) {
      return active() && (role() == 'owner' || myBranch() == b);
    }
    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function changing(field) {
      return field in request.resource.data.diff(resource.data).affectedKeys();
    }
    /**
     * A "who did this" field must name the person actually doing it.
     *
     * There are no approval queues in this system — the owner's rule is that
     * visibility replaces approval, so anyone may void a sale or reopen a day
     * and every action is stamped and surfaces on his dashboard. That makes the
     * stamp the *only* control against a cashier voiding their own takings, and
     * a stamp the client picks the value of is not a control at all: the field
     * was whitelisted as changeable, but nothing said it had to be true.
     */
    function stampedHonestly(field) {
      return !changing(field) || request.resource.data[field] == request.auth.uid;
    }

    // --- Enter-once sources: owner writes, everyone reads -------------------

    // Public read: the login screen lists staff names before anyone is signed
    // in. These docs hold no secrets — PINs live in Firebase Auth, never here.
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner();
      allow delete: if false;
    }

    match /branches/{branchId} {
      allow read: if true;
      allow create, update: if isOwner();
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // One rate sheet per day for the whole business: the price of the things
    // that are bought fresh and priced fresh — eggs, bread when flour moves.
    //
    // Everyone signed in reads it, because every till needs it to charge
    // correctly. Only the owner writes it: a rate is a decision about margin,
    // not a counter operation.
    match /dailyRates/{rateId} {
      allow read: if signedIn();
      allow create, update: if isOwner();

      // Never deleted. A day's rates are what the takings for that day were
      // built on, and removing the sheet would leave those figures unexplained.
      allow delete: if false;
    }

    // --- Money: append-only ------------------------------------------------

    match /sales/{saleId} {
      // Order matters. The owner clause is checked first and touches no
      // document field, so an owner's unfiltered query is provably allowed.
      // Reaching for `resource.data` before that — even via `.get` with a
      // default — makes the whole query unprovable and it is refused outright.
      // Reading one sale: check the branch on the document itself.
      allow get: if isOwner() || (active() && resource.data.branchId == myBranch());

      // Querying many is a different thing, and needs separate statements.
      //
      // On a query Firestore does not run the rule against each row — it
      // decides up front whether the query as written can only return allowed
      // rows. `resource` is empty during that check, so touching
      // `resource.data` inside a larger `||` makes the whole expression error
      // out rather than fall through to the branch that would have passed.
      // Written as two statements they are considered independently: the owner
      // is allowed outright, and everyone else is allowed only when the query
      // pins their own outlet, which Firestore matches against the constraint.
      allow list: if isOwner();
      allow list: if active() && resource.data.branchId == myBranch();

      allow create: if staff()
                    && canWriteBranch(request.resource.data.branchId)
                    && request.resource.data.cashierId == request.auth.uid
                    && request.resource.data.total is number
                    && request.resource.data.status in ['normal', 'refund'];

      // Void a sale, or correct the payment type. Nothing else may change, and
      // whoever did it signs their own name to it — see stampedHonestly.
      allow update: if staff()
                    && canWriteBranch(resource.data.branchId)
                    && changedOnly([
                         'status', 'voidReason', 'voidedBy', 'voidedAt',
                         'payment', 'paymentChangedBy', 'paymentChangedAt'
                       ])
                    && stampedHonestly('voidedBy')
                    && stampedHonestly('paymentChangedBy');

      allow delete: if false;
    }

    // One doc per outlet per day: cash-up (and, from phase 4, the waste count).
    match /closings/{closingId} {
      // `resource == null` is not decoration. This document is fetched by id —
      // 'C-20260808-B2' — and for most of the day it does not exist yet. A rule
      // that reaches for resource.data cannot be evaluated against a document
      // that is not there, so the read is refused rather than answered "no such
      // document", and the till logs a permission error every single morning
      // while it asks whether the day has been closed. It failed closed, so
      // nothing broke; it just buried the console in denials that look exactly
      // like the real ones.
      //
      // The cost of allowing it: a cashier can tell whether another outlet has
      // closed a given day, because "does not exist" now answers where it used
      // to refuse. In a three-shop bakery whose staff already read every
      // outlet's orders, that is not a secret worth a daily false alarm.
      allow get: if isOwner()
                 || (active() && (resource == null || resource.data.branchId == myBranch()));
      // See the note on sales about why a query needs its own statements.
      allow list: if isOwner();
      allow list: if active() && resource.data.branchId == myBranch();

      allow create: if staff() && canWriteBranch(request.resource.data.branchId);

      // The outlet that closed a day can reopen and re-close it. An accidental
      // tap must never leave a shop unable to sell while it waits on the owner.
      // What it cannot do is move a close to another outlet or another day, and
      // every close and reopen is appended to the event trail for the owner to
      // see. Visibility rather than permission — the same bargain as voids.
      //
      // The trail is the whole bargain, so it may only ever grow. Without that
      // last condition a re-close could overwrite `events` with a single tidy
      // entry, and the record of what the drawer said the first time — the one
      // thing that tells a corrected count from a quietly changed one — would
      // be gone, leaving a document that looks like it was closed once and
      // reconciled perfectly.
      allow update: if isOwner()
                    || (staff()
                        && canWriteBranch(resource.data.branchId)
                        && request.resource.data.branchId == resource.data.branchId
                        && request.resource.data.businessDate == resource.data.businessDate
                        && stampedHonestly('closedBy')
                        && stampedHonestly('reopenedBy')
                        && request.resource.data.get('events', []).size()
                             >= resource.data.get('events', []).size());

      allow delete: if false;
    }

    // --- The daily cycle ---------------------------------------------------
    //
    // Each record has exactly one writer at any moment, so two people can never
    // fight over the same field. For transfers the status is what separates
    // them: the hub writes while the note is a draft, the receiving outlet
    // writes only once it is on its way.

    match /demands/{demandId} {
      allow read: if staff();

      // An outlet places its own order, and only until the kitchen list is made.
      allow create: if staff()
                    && canWriteBranch(request.resource.data.branchId)
                    && request.resource.data.status in ['draft', 'submitted'];

      allow update: if isOwner()
                    || (staff()
                        && canWriteBranch(resource.data.branchId)
                        && resource.data.status != 'locked'
                        && request.resource.data.status in ['draft', 'submitted']);

      // Locking is part of compiling, not a thing anyone does on its own: once
      // the bake has been planned from an order, that order has to stop moving.
      // So whoever may build the list may close the orders it was built from,
      // and may change nothing else about them.
      allow update: if active() && role() == 'specialist'
                    && request.resource.data.status == 'locked'
                    && changedOnly(['status']);

      // An outlet that did not order at all gets last week's repeated for it,
      // as part of compiling. `auto` marks it as nobody's typing.
      //
      // This said `role() == 'specialist'` and nothing else, which left the
      // owner out — and the owner is who presses the button on a bakery with
      // one person running it. Every write in a compile goes in a single
      // batch, and a batch is atomic, so the moment one shop had not ordered
      // the whole compile was refused and the screen could say nothing more
      // useful than "Missing or insufficient permissions".
      allow create: if (isOwner() || (active() && role() == 'specialist'))
                    && request.resource.data.status == 'locked'
                    && request.resource.data.auto == true;

      allow delete: if false;
    }

    match /productionOrders/{orderId} {
      allow read: if staff();

      // Nobody *types* the baking list — it is still only ever added up from
      // the outlets' own orders. But somebody in the building has to be able to
      // ask for that addition to happen.
      //
      // This used to be `if false`, on the reasoning that the 05:00 job writes
      // it with admin rights and nothing else should. The cost of that landed
      // entirely on the kitchen: if the job had not run by 05:15 there was no
      // list, no one on the premises could create one, and the documented
      // remedy was to telephone the developer. A bakery cannot wait on a phone
      // call to find out what to bake.
      //
      // So the owner or a specialist may run the same compile from the app.
      // The arithmetic is `compileDemands` either way — the identical module
      // the scheduled job uses through functions/shared — so a list built by
      // hand at 05:15 is the list the job would have built at 05:00.
      allow create: if (isOwner() || (active() && role() == 'specialist'))
                    && request.resource.data.businessDate is string
                    && request.resource.data.items is list
                    && request.resource.data.compiledBy == request.auth.uid;

      // The kitchen adds how many came out of the oven — kept in its own map
      // precisely so this rule can name the fields it may touch. A rule cannot
      // reach inside the items array to protect one field of it.
      allow update: if isOwner()
                    || (active() && role() == 'specialist'
                        && changedOnly([
                             'produced', 'producedBy', 'status', 'extras',
                             'doneBy', 'doneByName', 'doneAt', 'updatedAt'
                           ]));

      allow delete: if false;
    }

    match /transfers/{transferId} {
      allow get: if isOwner()
                 || (active() && resource.data.toBranchId == myBranch())
                 || (active() && resource.data.fromBranch == myBranch());

      // One statement per way of asking, for the reason explained on sales.
      // Every transfer query must therefore pin `toBranchId` or `fromBranch`
      // — see data/transfers.js, which is written to do exactly that.
      allow list: if isOwner();
      allow list: if active() && resource.data.toBranchId == myBranch();
      allow list: if active() && resource.data.fromBranch == myBranch();

      // Delivery notes going out are created pre-filled by the compile, never
      // by hand. The one exception is stock an outlet sends back at the end of
      // its day: that note is written by the outlet it leaves, already on its
      // way, for the hub to confirm in the morning.
      //
      // Through `canWriteBranch` rather than a bare `myBranch()`, which is the
      // form every other branch-scoped write in this file uses. This one clause
      // was inlined, and so left the owner out — and the owner is registered at
      // MAIN while being explicitly allowed to work in whichever outlet he is
      // standing in. Closing Gulberg's day on Gulberg's tablet, his return was
      // refused, and the close wizard sends the return as part of the same act
      // as counting the drawer.
      allow create: if staff()
                    && request.resource.data.direction == 'return'
                    && canWriteBranch(request.resource.data.fromBranch)
                    && request.resource.data.status == 'dispatched'
                    && request.resource.data.businessDate is string;

      // The other exception: the delivery notes that come with a baking list
      // compiled from the app rather than by the 05:00 job. They are created
      // as drafts, which is the same state the job leaves them in — nothing is
      // on its way until the hub presses send on Dispatch.
      allow create: if (isOwner() || (active() && role() == 'specialist'))
                    && request.resource.data.direction == 'out'
                    && request.resource.data.status == 'draft'
                    && request.resource.data.businessDate is string;

      // Both halves name the fields they may touch and have to sign their own
      // name, like every other mutable record here. Without that, a note was
      // open house from either end: whoever could move it one step could also
      // rewrite its date, its branches, its direction, or the other side's
      // stamp — so a short delivery could be made to read as the sending
      // outlet's problem, signed by somebody who was not there.
      //
      // One hole stays open and is worth stating rather than implying: `items`
      // has to be writable at both steps, and a rule cannot reach inside an
      // array, so the receiving outlet can still alter the `qtySent` it is
      // supposedly counting against. Closing that means moving the counts into
      // their own map, the way `produced` is on productionOrders. Until then
      // the line count is pinned, so lines cannot be added or dropped, and
      // every figure stays visible side by side on the owner's screen.
      allow update: if isOwner()
                    // The hub sends: draft -> dispatched. Extras are added as
                    // new lines here, so the line count may grow.
                    || (active() && role() == 'specialist'
                        && resource.data.fromBranch == myBranch()
                        && resource.data.status == 'draft'
                        && request.resource.data.status == 'dispatched'
                        && changedOnly([
                             'items', 'status', 'dispatchedBy', 'dispatchedByName', 'dispatchedAt'
                           ])
                        && stampedHonestly('dispatchedBy'))
                    // The receiving outlet counts it in: dispatched -> received.
                    || (staff()
                        && resource.data.toBranchId == myBranch()
                        && resource.data.status == 'dispatched'
                        && request.resource.data.status == 'received'
                        && request.resource.data.items.size() == resource.data.items.size()
                        && changedOnly([
                             'items', 'status', 'receivedBy', 'receivedByName', 'receivedAt',
                             'receivedOn'
                           ])
                        && stampedHonestly('receivedBy'))
                    // An outlet correcting a return it has already sent, before
                    // the hub has confirmed it. A day can be reopened — the
                    // close wizard says so — and re-closing it sends the return
                    // again onto the same natural-key document, which is an
                    // update. No clause matched the sender, so reopening a day
                    // left the outlet unable to finish closing it again.
                    || (staff()
                        && resource.data.direction == 'return'
                        && canWriteBranch(resource.data.fromBranch)
                        && resource.data.status == 'dispatched'
                        && request.resource.data.status == 'dispatched'
                        // Correcting the count on a note, not re-addressing it.
                        && request.resource.data.direction == 'return'
                        && request.resource.data.fromBranch == resource.data.fromBranch
                        && request.resource.data.toBranchId == resource.data.toBranchId
                        && request.resource.data.businessDate == resource.data.businessDate);

      allow delete: if false;
    }

    match /dailyReports/{reportId} {
      allow get: if isOwner() || (active() && resource.data.branchId == myBranch());
      allow list: if isOwner();
      allow list: if active() && resource.data.branchId == myBranch();

      // Reports are compiled, never written by hand — not even by the owner.
      // Correcting a figure means correcting the day it came from.
      allow create, update, delete: if false;
    }

    // --- Raw materials (phase 5) -------------------------------------------

    // What the bakery buys, and what it pays for it. `data/materials.js` has
    // always said "raw materials are the owner's alone" and both screens that
    // read them are owner-only — this rule just did not say so, and `signedIn()`
    // is a lower bar than it looks: staff accounts are created through the app,
    // so anyone who can sign in could read the cost price of every ingredient.
    // Nothing in the client changes; it was already only ever asked for by the
    // owner's own screens.
    match /rawMaterials/{materialId} {
      allow read: if isOwner();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    match /purchases/{purchaseId} {
      allow read: if isOwner();
      allow create, update: if isOwner();
      allow delete: if false;
    }

    // Bills and wages. The owner's alone, like purchases — and for a stronger
    // reason: a salary sheet says what every member of staff is paid, and three
    // cashiers who can read each other's pay is a problem no software fixes.
    match /expenses/{expenseId} {
      allow read: if isOwner();
      allow create, update: if isOwner();

      // Never deleted. A month's profit was worked out from these, and removing
      // one would leave that figure unexplainable. A bill entered wrongly is
      // corrected by entering it again — the id is a natural key, so it lands
      // on the same document.
      allow delete: if false;
    }

    match /stockMovements/{movementId} {
      allow read: if isOwner();
      allow create: if isOwner();
      allow update, delete: if false;
    }

    // --- Faults reported by the tablets ------------------------------------

    match /clientErrors/{errorId} {
      // Only the owner reads these. A stack trace names the code and the outlet,
      // which is his business and nobody else's.
      allow get: if isOwner();
      allow list: if isOwner();

      // Any signed-in member of staff may report a fault on their own behalf.
      // Pinning userId to the caller keeps one tablet from filing reports in
      // somebody else's name, and means a flood can always be traced back.
      allow create: if staff()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.message is string;

      // A fault report is a fact about something that happened. Editing one
      // away would be editing the record of the thing going wrong.
      allow update, delete: if false;
    }

    // Anything not named above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
