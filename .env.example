# Copy to .env.local for local work against a real Firebase project, and set the
# same six values in Vercel (Project → Settings → Environment Variables).
#
# Leave them unset and the app runs against the local emulators instead — which
# is what you want for development, and useless once deployed, because a browser
# on the internet cannot reach 127.0.0.1. Setting VITE_FB_API_KEY is the switch.
#
# Find them in the Firebase console: Project settings → Your apps → Web app.
# None of these are secrets; a Firebase web config is public by design. What
# protects the data is firestore.rules, not these values.

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=
